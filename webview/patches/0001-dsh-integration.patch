+/** 上下文超长的兜底文案特征；Anthropic 兼容接口的 code 并不总是下发 */
+const CONTEXT_LENGTH_PATTERN = /maximum context length|context length|context_length|too long/i
+
+/**
+ * 对话上下文超过模型窗口：Anthropic 兼容接口通常返回 400（少数网关为 422），
+ * 错误体可能带 code，也可能只有英文 message。官方网页版对这种情况单独提示并引导开启新对话，
+ * 不展示原始报错，也不提供重试。
+ */
+export const isContextLengthExceededError = (error: unknown): boolean => {
+  if (!(error instanceof ApiError) || (error.status !== 400 && error.status !== 422)) {
+    return false
+  }
+  return (
+    error.code?.toLowerCase() === 'context_length_exceeded' ||
+    CONTEXT_LENGTH_PATTERN.test(error.message)
+  )
+}
+
